# ==========================================
# NextForm এনভায়রনমেন্ট ভেরিয়েবল কনফিগারেশন
# ==========================================

# মঙ্গোডিবি ক্লাউড (Atlas) অথবা লোকাল কানেকশন স্ট্রিং (Raw Driver)
MONGODB_URI=mongodb://localhost:27017/nextform_db

# NextAuth সিক্রেট কী
NEXTAUTH_SECRET=super_secret_jwt_security_token_nextform_development_key_12345
NEXTAUTH_URL=http://localhost:3000

# Google OAuth ক্রেডেনশিয়ালস
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary ক্লাউড স্টোরেজ ক্রেডেনশিয়ালস (ইমেজ ও ফাইল আপলোডের জন্য)
# Cloudinary ড্যাশবোর্ড থেকে সংগ্রহ করুন: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
